    <style>
            /* ======================================================
                               ПОЛНЫЙ СБРОС — перекрывает любые внешние стили страницы
                               ====================================================== */
            html, body, div, span, h1, h2, h3, h4, h5, h6, p, a, ul, li, table, tr, td, th, img, button {
                all: revert;
                box-sizing: border-box !important;
            }

            html {
                background: #16181c !important;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                min-height: 100vh !important;
                display: flex !important;
                flex-direction: column !important;
                font-family: "Segoe UI", Arial, sans-serif !important;
                font-size: 16px !important;
                background: #16181c !important;
                color: #d6d6d6 !important;
                line-height: 1.6 !important;
            }

            a {
                text-decoration: none !important;
                cursor: pointer !important;
            }

            * {
                box-sizing: border-box;
            }

            /* ====== ШАПКА ====== */
            .scp-header {
                background: radial-gradient(circle at 50% -40%, #23262c 0%, #0c0d10 70%);
                border-bottom: 1px solid #2a2d33;
                padding: 28px 20px 18px;
                text-align: center;
                position: relative;
                flex-shrink: 0;
            }

            .scp-account {
                position: absolute;
                top: 30px;
                right: 24px;
                font-size: 13px;
                color: #8fa8ff;
            }

                .scp-account span {
                    color: #6b6f78;
                    margin: 0 6px;
                }

            .scp-logo-wrap {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
            }

            .logo-link98 img {
                height: 90px;
            }

            .scp-title {
                font-size: clamp(28px, 6vw, 44px);
                font-weight: 800;
                letter-spacing: 1px;
                color: #a9c1ff;
                margin: 0;
            }

            .scp-subtitle {
                font-size: 13px;
                letter-spacing: 4px;
                color: #e8e8e8;
                font-weight: 700;
                margin-top: 4px;
            }

            /* ====== НАВИГАЦИЯ ====== */
            .scp-nav {
                display: flex;
                justify-content: center;
                gap: 2px;
                margin: 18px auto 0;
                flex-wrap: wrap;
                padding: 0 10px;
                flex-shrink: 0;
            }

                .scp-nav a {
                    display: inline-block;
                    background: #1c1e24;
                    border: 1px solid #34363d;
                    color: #a9c1ff;
                    font-weight: 700;
                    font-size: clamp(11px, 2vw, 13px);
                    padding: clamp(7px, 1.5vw, 9px) clamp(10px, 3vw, 18px);
                    border-radius: 4px;
                    cursor: pointer;
                    transition: background .15s, color .15s;
                }

                    .scp-nav a:hover {
                        background: #a9c1ff;
                        color: #16181c;
                    }

            .breadcrumb {
                text-align: center;
                font-size: 14px;
                margin: 22px 0 6px;
                color: #7c88a8;
            }

                .breadcrumb a {
                    color: #7c9cff;
                }

                .breadcrumb strong {
                    color: #d6d6d6;
                }

            /* ====== КОНТЕЙНЕР СТРАНИЦ ====== */
            main {
                max-width: 1100px;
                margin: 28px auto 60px;
                padding: 0 20px;
                flex: 1 0 auto;
                width: 100%;
            }

            h2.section-h {
                text-align: center;
                color: #ff5c5c;
                font-size: 26px;
                margin: 10px 0 30px;
            }

            /* ====== СПИСОК АНОМАЛИЙ ====== */
            .anomaly-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 15px;
            }

            .anomaly-card {
                display: flex;
                align-items: flex-start;
                background: #0e0e0e;
                border: 1px solid #2a2a2a;
                border-radius: 6px;
                padding: 14px 16px;
                text-decoration: none;
                color: #e0e0e0;
                transition: transform 0.2s, box-shadow 0.2s;
                box-shadow: inset 0 0 10px rgba(0,0,0,0.7), 0 5px 15px rgba(0,0,0,0.6);
            }

                .anomaly-card:hover {
                    transform: scale(1.02);
                    box-shadow: inset 0 0 10px rgba(0,0,0,0.7), 0 5px 20px rgba(169,193,255,0.35);
                }

            .anomaly-dot {
                width: 13px;
                height: 13px;
                border-radius: 50%;
                margin-right: 12px;
                margin-top: 5px;
                flex-shrink: 0;
            }

                .anomaly-dot.green {
                    background: #4caf50;
                }

                .anomaly-dot.yellow {
                    background: #ffeb3b;
                }

                .anomaly-dot.red {
                    background: #f44336;
                }

                .anomaly-dot.blue {
                    background: #2196f3;
                }

                .anomaly-dot.orange {
                    background: #ff8a5c;
                }

            .anomaly-info strong {
                display: block;
                font-size: 1.05em;
                margin-bottom: 4px;
                color: #eaeaea;
            }

            .anomaly-info p {
                font-size: 0.9em;
                color: #cccccc;
                margin: 0;
            }

            .anomaly-info .obj-class-tag {
                display: block;
                font-size: 0.78em;
                margin-top: 6px;
                color: #8892a8;
                letter-spacing: 0.5px;
            }

            /* ====== ФУТЕР ====== */
            .scp-footer {
                text-align: center;
                padding: 22px;
                font-size: 14px;
                color: #6b6f78;
                border-top: 1px solid #2a2d33;
                background: #101114;
                flex-shrink: 0;
            }

            @@media (max-width: 480px) {
                .scp-account {
                    display: none;
                }

                .breadcrumb {
                    font-size: 12px;
                }
            }
    </style>

    <link rel="icon" type="image/x-icon" href="~/images/SIDS.png">
</head>
