}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>СИСТЕМА КЛАССОВ ОПАСНОСТИ</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
            /* ======================================================
                               ПОЛНЫЙ СБРОС — перекрывает любые внешние стили страницы
                               ====================================================== */
            html, body, div, span, h1, h2, h3, h4, h5, h6, p, a, ul, li, table, tr, td, th, img, button {
                all: revert;
                box-sizing: border-box !important;
            }

            html {
                background: #16181c !important;
            }

            body {
                margin: 0 !important;
                padding: 0 !important;
                min-height: 100vh !important;
                display: flex !important;
                flex-direction: column !important;
                font-family: "Segoe UI", Arial, sans-serif !important;
                font-size: 16px !important;
                background: #16181c !important;
                color: #d6d6d6 !important;
                line-height: 1.6 !important;
            }

            a {
                text-decoration: none !important;
                cursor: pointer !important;
            }

            * {
                box-sizing: border-box;
            }

            /* ====== ШАПКА ====== */
            .scp-header {
                background: radial-gradient(circle at 50% -40%, #23262c 0%, #0c0d10 70%);
                border-bottom: 1px solid #2a2d33;
                padding: 28px 20px 18px;
                text-align: center;
                position: relative;
                flex-shrink: 0;
            }

            .scp-account {
                position: absolute;
                top: 30px;
                right: 24px;
                font-size: 13px;
                color: #8fa8ff;
            }

                .scp-account span {
                    color: #6b6f78;
                    margin: 0 6px;
                }

            .scp-logo-wrap {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
            }

            .logo-link98 img {
                height: 90px;
            }

            .scp-title {
                font-size: clamp(28px, 6vw, 44px);
                font-weight: 800;
                letter-spacing: 1px;
                color: #a9c1ff;
                margin: 0;
            }

            .scp-subtitle {
                font-size: 13px;
                letter-spacing: 4px;
                color: #e8e8e8;
                font-weight: 700;
                margin-top: 4px;
            }

            /* ====== НАВИГАЦИЯ ====== */
            .scp-nav {
                display: flex;
                justify-content: center;
                gap: 2px;
                margin: 18px auto 0;
                flex-wrap: wrap;
                padding: 0 10px;
                flex-shrink: 0;
            }

                .scp-nav a {
                    display: inline-block;
                    background: #1c1e24;
                    border: 1px solid #34363d;
                    color: #a9c1ff;
                    font-weight: 700;
                    font-size: clamp(11px, 2vw, 13px);
                    padding: clamp(7px, 1.5vw, 9px) clamp(10px, 3vw, 18px);
                    border-radius: 4px;
                    cursor: pointer;
                    transition: background .15s, color .15s;
                }

                    .scp-nav a:hover {
                        background: #a9c1ff;
                        color: #16181c;
                    }

            .breadcrumb {
                text-align: center;
                font-size: 14px;
                margin: 22px 0 6px;
                color: #7c88a8;
            }

                .breadcrumb a {
                    color: #7c9cff;
                }

                .breadcrumb strong {
                    color: #d6d6d6;
                }

            /* ====== КОНТЕЙНЕР СТРАНИЦ ====== */
            main {
                max-width: 900px;
                margin: 28px auto 60px;
                padding: 0 20px;
                flex: 1 0 auto;
                width: 100%;
            }

            /* ====== УВЕДОМЛЕНИЕ / СПИСОК ПУНКТОВ ====== */
            .notice-box {
                border: 1px solid #4a5580;
                background: #1a1d24;
                border-radius: 4px;
                padding: 22px 30px;
                text-align: left;
                margin-bottom: 30px;
            }

                .notice-box h3 {
                    color: #eaeaea;
                    letter-spacing: 2px;
                    font-size: 18px;
                    margin: 0 0 14px;
                    text-align: center;
                }

                .notice-box p {
                    position: relative;
                    color: #b7bccb;
                    font-size: 16px;
                    margin: 0 0 12px;
                    padding-left: 18px;
                    text-align: left;
                }

                    .notice-box p::before {
                        content: "";
                        position: absolute;
                        top: 8px;
                        left: 0;
                        width: 7px;
                        height: 7px;
                        border-radius: 50%;
                        background: #7c9cff;
                    }

                    .notice-box p:last-child {
                        margin-bottom: 0;
                    }

            /* ====== СТАТЬЯ ====== */
            .article p {
                margin: 0 0 18px;
                font-size: 17px;
            }

            .article strong {
                color: #eaeaea;
            }

            .obj-class {
                color: #ff5c5c;
                font-weight: 700;
            }

            /*ff5c5c-красный*/
            /* 2196f3синий*/
            /* ff8a5c-обычный*/

            .article hr {
                border: none;
                border-top: 1px solid #2a2d33;
                margin: 26px 0;
            }

            .strike {
                text-decoration: line-through;
                opacity: .6;
            }

            h2.section-h {
                text-align: center;
                color: #ff5c5c;
                font-size: 24px;
                margin: 40px 0 20px;
            }

            /* ====== ФУТЕР ====== */
            .scp-footer {
                text-align: center;
                padding: 22px;
                font-size: 14px;
                color: #6b6f78;
                border-top: 1px solid #2a2d33;
                background: #101114;
                flex-shrink: 0;
            }

            .image-block {
                float: left;
                margin-right: 15px;
                margin-bottom: 20px;
                padding: 0;
                max-width: 300px;
            }

                .image-block img {
                    width: 100%;
                    border: 3px solid #7c9cff;
                }

            /* ====== БЕЙДЖ УРОВНЯ ДОСТУПА ====== */
            .access-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 12px;
                border-radius: 3px;
                font-weight: 700;
                font-size: 14px;
                letter-spacing: 0.5px;
                margin-left: 6px;
                vertical-align: middle;
            }

                .access-badge::before {
                    content: "";
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: currentColor;
                    flex-shrink: 0;
                }

            .access-lvl-1 {
                background: #1f3a1f;
                color: #7fd67f;
                border: 1px solid #3a6a3a;
            }

            .access-lvl-2 {
                background: #3a3a00;
                color: #fff09a;
                border: 1px solid #9a8f00;
            }

            .access-lvl-3 {
                background: #402400;
                color: #ffb266;
                border: 1px solid #a05a00;
            }

            .access-lvl-4 {
                background: #3a0000;
                color: #ff8a8a;
                border: 1px solid #8a0000;
            }

            .access-lvl-5 {
                background: #080808;
                color: #ff4d4d;
                border: 1px solid #500000;
                box-shadow: 0 0 8px rgba(255, 0, 0, 0.15);
            }

            .nav-buttons {
                display: flex;
                justify-content: center;
                gap: 10px;
                flex-wrap: wrap;
                margin: 20px 0 0;
            }

                .nav-buttons a {
                    background: #333;
                    color: #fff;
                    padding: 8px 16px;
                    border-radius: 6px;
                    font-size: 13px;
                }

                    .nav-buttons a:hover {
                        background: #555;
                    }

            @@media (max-width: 480px) {
                .scp-account {
                    display: none;
                }

                .breadcrumb {
                    font-size: 12px;
                }
            }
    </style>

    <link rel="icon" type="image/x-icon" href="~/images/SIDS.png">
