            /* ====== БЕЙДЖ УРОВНЯ ДОСТУПА ====== */
            .access-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 4px 12px;
                border-radius: 3px;
                font-weight: 700;
                font-size: 14px;
                letter-spacing: 0.5px;
                margin-left: 6px;
                vertical-align: middle;
            }

                .access-badge::before {
                    content: "";
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: currentColor;
                    flex-shrink: 0;
                }

            .access-lvl-1 {
                background: #1f3a1f;
