            }

            * {
                box-sizing: border-box;
            }

            /* ====== ШАПКА ====== */
            .scp-header {
                background: radial-gradient(circle at 50% -40%, #23262c 0%, #0c0d10 70%);
                border-bottom: 1px solid #2a2d33;
                padding: 28px 20px 18px;
                text-align: center;
                position: relative;
                flex-shrink: 0;
            }

            .scp-account {
                position: absolute;
                top: 30px;
                right: 24px;
                font-size: 13px;
                color: #8fa8ff;
            }

                .scp-account span {
                    color: #6b6f78;
                    margin: 0 6px;
                }

            .scp-logo-wrap {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 4px;
            }

            .logo-link98 img {
                height: 90px;
            }

            .scp-title {
                font-size: clamp(28px, 6vw, 44px);
                font-weight: 800;
                letter-spacing: 1px;
                color: #a9c1ff;
                margin: 0;
            }

            .scp-subtitle {
                font-size: 13px;
                letter-spacing: 4px;
                color: #e8e8e8;
                font-weight: 700;
                margin-top: 4px;
            }

            /* ====== НАВИГАЦИЯ ====== */
            .scp-nav {
                display: flex;
                justify-content: center;
                gap: 2px;
                margin: 18px auto 0;
                flex-wrap: wrap;
                padding: 0 10px;
                flex-shrink: 0;
            }

                .scp-nav a {
                    display: inline-block;
                    background: #1c1e24;
                    border: 1px solid #34363d;
                    color: #a9c1ff;
                    font-weight: 700;
                    font-size: clamp(11px, 2vw, 13px);
                    padding: clamp(7px, 1.5vw, 9px) clamp(10px, 3vw, 18px);
                    border-radius: 4px;
                    cursor: pointer;
                    transition: background .15s, color .15s;
                }

                    .scp-nav a:hover {
                        background: #a9c1ff;
                        color: #16181c;
                    }

            .breadcrumb {
                text-align: center;
                font-size: 14px;
                margin: 22px 0 6px;
                color: #7c88a8;
            }

                .breadcrumb a {
                    color: #7c9cff;
                }

                .breadcrumb strong {
                    color: #d6d6d6;
                }

            /* ====== КОНТЕЙНЕР СТРАНИЦ ====== */
            main {
                max-width: 900px;
                margin: 28px auto 60px;
                padding: 0 20px;
                flex: 1 0 auto;
                width: 100%;
            }

            /* ====== УВЕДОМЛЕНИЕ / ДИАЛОГ ====== */
            .notice-box {
                border: 1px solid #4a5580;
                background: #1a1d24;
                border-radius: 4px;
                padding: 22px 30px;
                text-align: left;
                margin-bottom: 30px;
            }

                .notice-box h3 {
                    color: #eaeaea;
                    letter-spacing: 2px;
                    font-size: 18px;
                    margin: 0 0 14px;
                    text-align: center;
                }

                .notice-box p {
                    color: #b7bccb;
                    font-size: 16px;
                    margin: 0 0 10px;
                    text-align: left;
                }

            /* ====== СТАТЬЯ ====== */
            .article p {
                margin: 0 0 18px;
                font-size: 17px;
            }

            .article strong {
                color: #eaeaea;
            }

            .obj-class {
                color: #ff5c5c;
                font-weight: 700;
            }

            /*ff5c5c-красный*/

            /* 2196f3синий*/

            /* ff8a5c-обычный*/

            .article hr {
                border: none;
                border-top: 1px solid #2a2d33;
                margin: 26px 0;
            }

            .strike {
                text-decoration: line-through;
                opacity: .6;
            }

            h2.section-h {
                text-align: center;
                color: #ff5c5c;
                font-size: 24px;
                margin: 40px 0 20px;
            }

            /* ====== ФУТЕР ====== */
            .scp-footer {
